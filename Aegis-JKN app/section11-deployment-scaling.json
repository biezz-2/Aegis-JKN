  {
    "type": "heading",
    "heading": {
      "text": "11.4 Manajemen Layer Data & Storage",
      "level": 3
    }
  },
  {
    "type": "bulleted_list_item",
    "bulleted_list_item": {
      "text": "Primary Store: PostgreSQL (Aurora/RDS) dengan Read Replicas untuk query reporting.",
      "bulleted_list_item_rich_text": []
    }
  },
  {
    "type": "bulleted_list_item",
    "bulleted_list_item": {
      "text": "Feature Store: Feast (Offline: S3 Parquet, Online: Redis) untuk sinkronisasi fitur GCN.",
      "bulleted_list_item_rich_text": []
    }
  },
  {
    "type": "bulleted_list_item",
    "bulleted_list_item": {
      "text": "Model Registry: MLflow terintegrasi dengan S3 artifact store untuk versioning model.",
      "bulleted_list_item_rich_text": []
    }
  },
  {
    "type": "bulleted_list_item",
    "bulleted_list_item": {
      "text": "Data Lake: Delta Lake pada S3 untuk audit trail immutable dan retraining data.",
      "bulleted_list_item_rich_text": []
    }
  },
  {
    "type": "heading",
    "heading": {
      "text": "11.5 Observabilitas (The Three Pillars)",
      "level": 3
    }
  },
  {
    "type": "table",
    "table": {
      "header_row": [
        { "text": "Pillar" },
        { "text": "Tooling" },
        { "text": "Key Metrics / Fokus" }
      ],
      "rows": [
        [
          { "text": "Metrics" },
          { "text": "Prometheus + Grafana" },
          { "text": "RED Metrics (Rate, Errors, Duration), GPU Utilization" }
        ],
        [
          { "text": "Logs" },
          { "text": "Loki / ELK Stack" },
          { "text": "Structured JSON, trace_id correlation, Audit Logs" }
        ],
        [
          { "text": "Traces" },
          { "text": "Jaeger / Tempo" },
          { "text": "OpenTelemetry spans, End-to-end Latency Analysis" }
        ]
      ]
    }
  },
  {
    "type": "paragraph",
    "paragraph": {
      "text": "Service Level Objectives (SLOs):"
    }
  },
  {
    "type": "bulleted_list_item",
    "bulleted_list_item": {
      "text": "Latency: p99 < 500ms untuk scoring real-time.",
      "bulleted_list_item_rich_text": []
    }
  },
  {
    "type": "bulleted_list_item",
    "bulleted_list_item": {
      "text": "Availability: 99.9% uptime per tahun.",
      "bulleted_list_item_rich_text": []
    }
  },
  {
    "type": "bulleted_list_item",
    "bulleted_list_item": {
      "text": "Error Rate: < 0.1% failure rate pada API requests.",
      "bulleted_list_item_rich_text": []
    }
  },
  {
    "type": "heading",
    "heading": {
      "text": "11.6 Security Hardening & Compliance",
      "level": 3
    }
  },
  {
    "type": "bulleted_list_item",
    "bulleted_list_item": {
      "text": "Network: Isolasi Private Subnets, NAT Gateway, dan WAF (Web Application Firewall).",
      "bulleted_list_item_rich_text": []
    }
  },
  {
    "type": "bulleted_list_item",
    "bulleted_list_item": {
      "text": "Secrets: HashiCorp Vault / AWS Secrets Manager untuk enkripsi kunci API & DB.",
      "bulleted_list_item_rich_text": []
    }
  },
  {
    "type": "bulleted_list_item",
    "bulleted_list_item": {
      "text": "Compliance: Pod Security Standards (Restricted) dan Kyverno policies untuk runtime security.",
      "bulleted_list_item_rich_text": []
    }
  },
  {
    "type": "bulleted_list_item",
    "bulleted_list_item": {
      "text": "Supply Chain: Cosign image signing, SBOM (Syft), dan Trivy scanning pada pipeline CI.",
      "bulleted_list_item_rich_text": []
    }
  },
  {
    "type": "heading",
    "heading": {
      "text": "11.7 Optimasi Biaya (Cost Efficiency)",
      "level": 3
    }
  },
  {
    "type": "bulleted_list_item",
    "bulleted_list_item": {
      "text": "Compute: Penggunaan Spot Instances untuk Batch Workers (potensi hemat hingga 70%).",
      "bulleted_list_item_rich_text": []
    }
  },
  {
    "type": "bulleted_list_item",
    "bulleted_list_item": {
      "text": "GPU: Implementasi NVIDIA MIG (Multi-Instance GPU) untuk sharing resource antar-model.",
      "bulleted_list_item_rich_text": []
    }
  },
  {
    "type": "bulleted_list_item",
    "bulleted_list_item": {
      "text": "Storage: Data tiering (Hot: Redis, Warm: Postgres, Cold: S3 Glacier).",
      "bulleted_list_item_rich_text": []
    }
  }
]